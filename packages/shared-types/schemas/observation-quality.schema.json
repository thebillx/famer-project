{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agriscope.local/schemas/observation-quality.schema.json",
  "title": "ObservationQuality",
  "type": "object",
  "required": [
    "valid_pixel_ratio",
    "cloud_pixel_ratio",
    "shadow_pixel_ratio",
    "no_data_ratio",
    "quality_score",
    "analysis_confidence",
    "quality_reason"
  ],
  "properties": {
    "valid_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "cloud_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "shadow_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "no_data_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "analysis_confidence": {
      "type": "string",
      "enum": ["not_analyzable", "low", "medium", "high"]
    },
    "quality_reason": { "type": "string" }
  }
}
